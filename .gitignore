# Gitignore for Sky Recomp (Native PC Port)

# Proprietary game files and keys (NEVER commit to GitHub)
*.keys
*.nsp
*.xci
*.nca
*.tik
Rom Game/*.nsp
Rom Game/*.xci
Rom Game/*.keys
Rom Game/*.bin
/Rom Game/
/extracted/
/gamelib-src/
/icon.png
/Baloo2-SemiBold.ttf
/Baloo2-OFL.txt
# Imported console fonts stay local; only the open interface font is distributed.
/fonts/*
!/fonts/Baloo2-SemiBold.ttf
!/fonts/Baloo2-OFL.txt

extracted/romfs.bin
extracted/romfs/
extracted/exefs/
extracted/skygame.dll
extracted/*.o
extracted/*.id

# Locally generated recompiled source code
ssh_generated/
generated/

# Build artifacts, caches, and local saves
/skyrecomp.exe
/skyrecomp.dll.a
/*.dll
/tools/*.exe
build/
cache/
save/
scratch/

# User installed mods
mods/*

# Local user configuration
skyrecomp.ini
larecomp.ini

# Logs and test captures
*.log
*.wav
*.bin
*.csv

# Python and system caches
__pycache__/
*.pyc
venv/
tools/venv/
.DS_Store
Thumbs.db
.vs/
.vscode/

# Downloaded compilers
zig/

# Optional locally installed ReShade runtime, presets and effects
/reshade/
/reshade-shaders/
/ReShade*.ini
/ReShade*.log*
/HenrikoMagnifico_*.ini
